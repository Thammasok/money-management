# backend/.env.example — every runtime variable of the API (src/config/app-config.ts). This is the deploy contract:
# `# config` = non-sensitive, plain environment / ConfigMap; `# secret` = secret manager only, never committed.
# A variable without a tag is treated as a secret.

NODE_ENV=production                   # config   production makes the session cookie Secure and sends HSTS
PORT=3000                             # config   port the API listens on
COOKIE_SECURE=                        # config   "true" or "false"; empty = true when NODE_ENV=production
NO_COLOR=1                            # config   Nest's logger drops ANSI colour codes, so aggregated logs stay plain text
DATABASE_URL=                         # secret   required: postgresql://user:password@host:5432/database

# Health probe for an orchestrator: GET /api/v1/me answers 401 when the API is up (it needs no database).
