# .env.example — the variables docker-compose.yml reads. Copy to `.env` (git-ignored) and fill in the secret.
# `# config` vs `# secret` decides where each value lands at deploy time: config = plain environment / ConfigMap,
# secret = a secret manager only. Only the NAME of a secret is ever committed, never its value. A variable without a
# tag is treated as a secret.
#
# The API on its own (what a Kubernetes deploy reads) is listed in backend/.env.example.

POSTGRES_PASSWORD=                    # secret   required; URL-safe characters only, it is embedded in DATABASE_URL: openssl rand -hex 24
WEB_PORT=8080                         # config   host port the web container is published on
WEB_BIND=127.0.0.1                    # config   host address it is bound to; 0.0.0.0 only when the TLS proxy is another machine
APP_VERSION=local                     # config   image tag; rollback = the previous value
COOKIE_SECURE=true                    # config   false only for a plain-http try-out (also turns HSTS off)
LIQUIBASE_CONTEXTS=prod               # config   production = prod (schema only); a dev environment may use test (adds the seed User)
TRUSTED_PROXY_CIDR=127.0.0.1/32       # config   the load balancer in front of web (its X-Forwarded-For names the client); default trusts nobody
