meta {
  name: AT-04-10 opening balance with decimals
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidCreate}}
}

body:json {
  {
    "name": "Cash",
    "currency": "THB",
    "openingBalanceMinor": "12.50"
  }
}

tests {
  // S-16 — minor units are whole numbers
  test("400 with exactly ['Opening balance must be a whole number of minor units.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Opening balance must be a whole number of minor units."], error: "Bad Request" });
  });
}
