meta {
  name: AT-04-03 missing name
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidCreate}}
}

body:json {
  {
    "currency": "THB",
    "openingBalanceMinor": "0"
  }
}

tests {
  // S-14 — name is required
  test("400 with exactly ['Enter a wallet name.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Enter a wallet name."], error: "Bad Request" });
  });
}
