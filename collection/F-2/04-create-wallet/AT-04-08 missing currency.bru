meta {
  name: AT-04-08 missing currency
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidCreate}}
}

body:json {
  {
    "name": "Cash",
    "openingBalanceMinor": "0"
  }
}

tests {
  // S-15 — Currency is required
  test("400 with exactly ['Choose a supported currency.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Choose a supported currency."], error: "Bad Request" });
  });
}
