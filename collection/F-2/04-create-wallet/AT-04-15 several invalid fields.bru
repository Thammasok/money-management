meta {
  name: AT-04-15 several invalid fields
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidCreate}}
}

body:json {
  {
    "name": "",
    "currency": "THB",
    "openingBalanceMinor": "abc"
  }
}

tests {
  // S-14 + S-16 — one message per failing field
  test("400 listing both messages", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("Bad Request");
    expect(res.getBody().message).to.have.members(["Enter a wallet name.", "Opening balance must be a whole number of minor units."]);
  });
}
