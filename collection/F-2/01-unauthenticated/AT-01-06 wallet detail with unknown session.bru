meta {
  name: AT-01-06 wallet detail with unknown session
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/wallets/3f6c1a52-9d7e-4b8a-a1c4-5e2f7d9b0c13
  body: none
  auth: none
}

headers {
  Cookie: sid={{unknownSid}}
}

script:pre-request {
  bru.setVar("unknownSid", "does-not-exist");
}

tests {
  // S-23 — an unknown session id is not signed in (401 before 404)
  test("401 Not signed in. (exact body)", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ statusCode: 401, message: "Not signed in.", error: "Unauthorized" });
  });
}
