meta {
  name: AT-06-09 amount zero
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

body:json {
  {
    "kind": "expense",
    "amountMinor": "0",
    "occurredOn": "{{today}}",
    "today": "{{today}}"
  }
}

tests {
  // S-18 — amounts are > 0
  test("400 with exactly ['Amount must be greater than 0.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Amount must be greater than 0."], error: "Bad Request" });
  });
}
