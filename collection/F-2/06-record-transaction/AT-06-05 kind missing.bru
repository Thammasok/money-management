meta {
  name: AT-06-05 kind missing
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

body:json {
  {
    "amountMinor": "100",
    "occurredOn": "{{today}}",
    "today": "{{today}}"
  }
}

tests {
  // S-19
  test("400 with exactly ['Choose income or expense.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Choose income or expense."], error: "Bad Request" });
  });
}
