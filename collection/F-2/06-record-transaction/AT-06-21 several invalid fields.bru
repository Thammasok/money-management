meta {
  name: AT-06-21 several invalid fields
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

body:json {
  {
    "kind": "gift",
    "amountMinor": "0",
    "occurredOn": "{{today}}",
    "today": "{{today}}"
  }
}

tests {
  // S-19 — one message per failing field
  test("400 listing both messages", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("Bad Request");
    expect(res.getBody().message).to.have.members(["Choose income or expense.", "Amount must be greater than 0."]);
    expect(res.getBody().message).to.have.length(2);
  });
}
