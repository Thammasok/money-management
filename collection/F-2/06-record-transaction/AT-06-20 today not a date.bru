meta {
  name: AT-06-20 today not a date
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

body:json {
  {
    "kind": "expense",
    "amountMinor": "100",
    "occurredOn": "{{today}}",
    "today": "tomorrow"
  }
}

tests {
  // S-19 — the future check is skipped when today itself is invalid
  test("400 with exactly ['today must be a valid date (YYYY-MM-DD).']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["today must be a valid date (YYYY-MM-DD)."], error: "Bad Request" });
  });
}
