meta {
  name: AT-06-06 amount as JSON number
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

body:json {
  {
    "kind": "expense",
    "amountMinor": 12550,
    "occurredOn": "{{today}}",
    "today": "{{today}}"
  }
}

tests {
  // S-19 — money is a decimal-integer STRING
  test("400 with exactly ['Amount must be a whole number of minor units.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Amount must be a whole number of minor units."], error: "Bad Request" });
  });
}
