meta {
  name: AT-06-23 nothing was saved
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/api/v1/wallets/{{walletIdRec}}
  body: none
  auth: none
}

headers {
  Cookie: sid={{sidRec}}
}

tests {
  // S-17 / S-19 — none of the refused requests stored a Transaction
  test("no Transactions; Balance = Opening Balance", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().transactions).to.deep.equal([]);
    expect(res.getBody().balanceMinor).to.equal("100000");
  });
}
