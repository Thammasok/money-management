meta {
  name: AT-08-09 record into malformed id
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/wallets/not-a-uuid/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidIntruder}}
}

body:json {
  {
    "today": "{{today}}",
    "kind": "expense",
    "amountMinor": "100",
    "occurredOn": "{{today}}"
  }
}

tests {
  // S-21 — a valid body to a malformed id is 404
  test("404 Wallet not found. (exact body)", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ statusCode: 404, message: "Wallet not found.", error: "Not Found" });
  });
}
