meta {
  name: AT-08-06 intruder list is empty
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/wallets
  body: none
  auth: none
}

headers {
  Cookie: sid={{sidIntruder}}
}

tests {
  // S-20 — A-Cash is not in the intruder's list
  test("200 { wallets: [] }", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({ wallets: [] });
  });
}
