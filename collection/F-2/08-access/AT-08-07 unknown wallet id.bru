meta {
  name: AT-08-07 unknown wallet id
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/wallets/00000000-0000-4000-8000-000000000000
  body: none
  auth: none
}

headers {
  Cookie: sid={{sidIntruder}}
}

tests {
  // S-21 — an id that does not exist
  test("404 Wallet not found. (exact body)", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ statusCode: 404, message: "Wallet not found.", error: "Not Found" });
  });
}
