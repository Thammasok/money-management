meta {
  name: AT-04-04 empty name
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/wallets/{{wRn}}
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRn}}
}

body:json {
  {
    "name": ""
  }
}

tests {
  // S-11 — an empty string is a name to check, not "no change"
  test("400 with exactly ['Enter a wallet name.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Enter a wallet name."], error: "Bad Request" });
  });
}
