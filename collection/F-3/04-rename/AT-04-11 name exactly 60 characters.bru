meta {
  name: AT-04-11 name exactly 60 characters
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/wallets/{{wRn}}
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRn}}
}

body:json {
  {
    "name": "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW"
  }
}

tests {
  // S-11 — the boundary is allowed
  test("200 with the 60-character name", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW");
  });
}
