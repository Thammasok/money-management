tests {
  // S-11, S-13 — refused requests changed nothing, not even updatedAt
  test("still Cash, untouched", function () {
    expect(res.getStatus()).to.equal(200);
    const w = res.getBody();
    expect(w.name).to.equal("Cash");
    expect(w.updatedAt).to.equal(bru.getVar("rnUpdatedAt"));
    expect(w.archivedAt).to.equal(null);
  });
}
