meta {
  name: AT-04-08 null name is nothing to change
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/wallets/{{wRn}}
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidRn}}
}

body:json {
  {
    "name": null
  }
}

tests {
  // S-13 — null means "not changing"
  test("400 with exactly ['Nothing to change.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Nothing to change."], error: "Bad Request" });
  });
}
