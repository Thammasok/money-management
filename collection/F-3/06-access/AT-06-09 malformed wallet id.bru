meta {
  name: AT-06-09 malformed wallet id
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/wallets/not-a-uuid
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidAcIntruder}}
}

body:json {
  {
    "archived": true
  }
}

tests {
  // S-14 — a malformed id is 404, never 400
  test("404 Wallet not found. (exact body)", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.deep.equal({ statusCode: 404, message: "Wallet not found.", error: "Not Found" });
  });
}
