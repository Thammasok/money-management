meta {
  name: AT-05-07 several invalid fields
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/wallets/{{wArOld}}
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidAr}}
}

body:json {
  {
    "name": "",
    "archived": false
  }
}

tests {
  // S-11, S-13 — one message per field, DTO order
  test("400 with exactly ['Enter a wallet name.','Archived can only be set to true.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Enter a wallet name.","Archived can only be set to true."], error: "Bad Request" });
  });
}
