meta {
  name: AT-05-14 rename archived wallet
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/wallets/{{wArOld}}
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidAr}}
}

body:json {
  {
    "name": "Old Cash"
  }
}

tests {
  // S-5 — archive blocks only new Transactions; rename still works and keeps the archive
  test("200 renamed, still archived", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Old Cash");
    expect(res.getBody().archivedAt).to.equal(bru.getVar("arOldArchivedAt"));
  });
}
