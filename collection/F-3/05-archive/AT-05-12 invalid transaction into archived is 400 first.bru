meta {
  name: AT-05-12 invalid transaction into archived is 400 first
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/wallets/{{wArOld}}/transactions
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidAr}}
}

body:json {
  {
    "kind": "transfer",
    "amountMinor": "100",
    "occurredOn": "{{today}}",
    "today": "{{today}}"
  }
}

tests {
  // S-12 — request shape (400) before the archived state (409)
  test("400 with exactly ['Choose income or expense.']", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ statusCode: 400, message: ["Choose income or expense."], error: "Bad Request" });
  });
}
