meta {
  name: AT-03-03 create Big1 KRW
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/wallets
  body: json
  auth: none
}

headers {
  Cookie: sid={{sidOv}}
}

body:json {
  {
    "name": "Big1",
    "currency": "KRW",
    "openingBalanceMinor": "999999999999999"
  }
}

script:post-response {
  bru.setVar("wOvBig1", res.getBody() && res.getBody().id);
}

tests {
  // setup — F-2 create; F-3 adds archivedAt (null = active) to every Wallet body
  test("201 Wallet with exactly the Wallet keys, active", function () {
    expect(res.getStatus()).to.equal(201);
    const w = res.getBody();
    expect(Object.keys(w).sort()).to.deep.equal(["archivedAt", "balanceMinor", "createdAt", "currency", "id", "name", "openingBalanceMinor", "updatedAt"]);
    expect(w.archivedAt).to.equal(null);
    expect(w.name).to.equal("Big1");
    expect(w.balanceMinor).to.equal("999999999999999");
  });
}
