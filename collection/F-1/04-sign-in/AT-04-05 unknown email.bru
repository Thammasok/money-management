meta {
  name: AT-04-05 unknown email
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "ghost-{{runId}}@example.test",
    "password": "{{validPassword}}"
  }
}

tests {
  // S-18 — identical answer to a wrong password: no hint whether the email exists
  test("401 with the same body as a wrong password", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ statusCode: 401, message: "Email or password is incorrect.", error: "Unauthorized" });
  });
}
