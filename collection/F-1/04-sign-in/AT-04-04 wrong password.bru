meta {
  name: AT-04-04 wrong password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "case-{{runId}}@example.test",
    "password": "{{wrongPassword}}"
  }
}

tests {
  // S-17 — wrong password
  test("401 Email or password is incorrect.", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.deep.equal({ statusCode: 401, message: "Email or password is incorrect.", error: "Unauthorized" });
  });
  test("no session cookie issued", function () {
    const raw = [].concat(res.getHeader("set-cookie") || []).join("; ");
    expect(raw).to.not.match(/sid=[A-Za-z0-9_-]+/);
  });
}
