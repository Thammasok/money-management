meta {
  name: AT-06-03 paused even with correct password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "locked-{{runId}}@example.test",
    "password": "{{validPassword}}"
  }
}

script:post-response {
  bru.setVar("retryAtLocked", res.getBody() && res.getBody().retryAt);
}

tests {
  // S-19 — after 10 failures in 15 min the email is paused, even for the right password
  test("429 Too many failed sign-ins", function () {
    expect(res.getStatus()).to.equal(429);
    const body = res.getBody();
    expect(body.statusCode).to.equal(429);
    expect(body.message).to.equal("Too many failed sign-ins. Try again later.");
    expect(body.error).to.equal("Too Many Requests");
  });
  test("retryAt is ISO-8601, 14–15 minutes from now", function () {
    const retryAt = Date.parse(res.getBody().retryAt);
    const minutes = (retryAt - Date.now()) / 60000;
    expect(Number.isNaN(retryAt)).to.equal(false);
    expect(minutes).to.be.within(13.5, 15.05);
  });
  test("no session cookie issued", function () {
    const raw = [].concat(res.getHeader("set-cookie") || []).join("; ");
    expect(raw).to.not.match(/sid=[A-Za-z0-9_-]+/);
  });
}
