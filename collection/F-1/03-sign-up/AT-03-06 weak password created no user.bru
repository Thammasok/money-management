meta {
  name: AT-03-06 weak password created no user
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: none
}

body:json {
  {
    "email": "weak-{{runId}}@example.test",
    "password": "{{validPassword}}"
  }
}

tests {
  // S-15 — none of AT-03-01..05 created a User (a created User would accept no password here
  // anyway, but a 401 for an email that only ever failed validation proves nothing was stored)
  test("401 — no User exists for the rejected sign-ups", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().message).to.equal("Email or password is incorrect.");
  });
}
