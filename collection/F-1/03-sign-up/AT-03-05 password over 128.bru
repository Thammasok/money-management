meta {
  name: AT-03-05 password over 128
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "email": "weak-{{runId}}@example.test",
    "password": "{{longPassword}}"
  }
}

script:pre-request {
  // 129 characters, otherwise rule-shaped (letter + digit + symbol)
  bru.setVar("longPassword", "Aa1!" + "x".repeat(125));
}

tests {
  // S-15 boundary — 129 characters is over the maximum
  test("400 with the password rule message", function () {
    expect(bru.getVar("longPassword").length).to.equal(129);
    expect(res.getStatus()).to.equal(400);
    expect([].concat(res.getBody().message)).to.include("Password must be at least 8 characters and include a letter, a number, and a symbol.");
  });
}
