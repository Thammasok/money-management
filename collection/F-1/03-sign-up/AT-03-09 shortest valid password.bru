meta {
  name: AT-03-09 shortest valid password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "email": "short-{{runId}}@example.test",
    "password": "abcdef1!"
  }
}

tests {
  // S-7 — exactly 8 characters with a letter, a number, a symbol is accepted
  test("201", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().email).to.equal("short-" + bru.getVar("runId") + "@example.test");
  });
}
