meta {
  name: AT-03-01 password under 8
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: none
}

body:json {
  {
    "email": "weak-{{runId}}@example.test",
    "password": "abc1!"
  }
}

tests {
  // S-15 — password rule: under 8 characters
  test("400 with the password rule message", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("Bad Request");
    expect([].concat(res.getBody().message)).to.include("Password must be at least 8 characters and include a letter, a number, and a symbol.");
  });
}
